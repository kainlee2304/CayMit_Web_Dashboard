# ==============================================================================
# TAM MỸ SMART FRUIT ECOSYSTEM — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production, test)
APP_ENV=development
APP_NAME="Tam My Smart Fruit Backend"
API_V1_STR=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# Server Binding
HOST=0.0.0.0
PORT=8000

# PostgreSQL 16 + TimescaleDB + PostGIS Connection (Runtime Non-Superuser Role)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://tammy_app_user:app_secure_password_2026@localhost:5433/tammysmartfruit_clean_test
DATABASE_SYNC_URL=postgresql://tammy_app_user:app_secure_password_2026@localhost:5433/tammysmartfruit_clean_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis 7 In-Memory Cache & Celery Broker
REDIS_URL=redis://localhost:6379/0

# JWT RS256 Asymmetric Authentication Settings
JWT_ALGORITHM=RS256
JWT_ISSUER="tammy-smart-fruit-auth"
JWT_AUDIENCE="tammy-smart-fruit-api"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# RSA Keys (File path or raw PEM string)
JWT_PRIVATE_KEY_PATH="./jwt_rs256.key"
JWT_PUBLIC_KEY_PATH="./jwt_rs256.key.pub"

# CORS Configuration (Comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
